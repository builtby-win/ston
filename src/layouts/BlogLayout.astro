---
import '../styles/global.css'
import { Font } from 'astro:assets'
import Lightbox from '../components/Lightbox.astro'
import PostHog from '../components/posthog.astro'

interface PathSegment {
  name: string
  href: string | null
}

interface Props {
  title: string
  description?: string
  pathSegments?: PathSegment[]
  backHref?: string
  wide?: boolean
}

const {
  title,
  description = 'Daily findings and learnings',
  pathSegments = [],
  backHref = '/ston/',
  wide = false,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://builtby.win').href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <Font cssVariable="--font-jetbrains-mono" preload />

    <PostHog />
    <title>{title} | ston</title>
    <meta name="title" content={`${title} | ston`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={`${title} | ston`} />
    <meta property="og:description" content={description} />

    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={`${title} | ston`} />
    <meta property="twitter:description" content={description} />
  </head>
  <body>
    <div class:list={['blog-container', { wide }]}>
      <nav class="terminal-header">
        <span class="prompt-arrow">→</span>
        <a href="/ston/" class="path-base">~/builtby.win/ston</a>{pathSegments.map((segment) => (
          segment.href ? (
            <a href={segment.href} class="path-segment">/{segment.name}</a>
          ) : (
            <span class="path-current">/{segment.name}</span>
          )
        ))}
        <span class="git-info">git:(<span class="branch">main</span>)</span>
      </nav>
      <a href={backHref} class="back-link">← cd ../</a>
      <main class="blog-content">
        <slot />
      </main>
    </div>
    <Lightbox />

    <script>
      // Mermaid is large; load it only on pages that actually contain diagrams.
      if (document.querySelector('pre.mermaid')) {
        const { default: mermaid } = await import('mermaid')
        mermaid.initialize({ startOnLoad: false, theme: 'dark' })
        await mermaid.run({ querySelector: 'pre.mermaid' })
      }
    </script>

    <script>
      // Click a code block to copy it (unless the user is selecting text).
      document.addEventListener('click', async (e) => {
        const pre = (e.target as Element).closest<HTMLElement>('.blog-content pre:not(.mermaid)')
        if (!pre || getSelection()?.toString()) return
        await navigator.clipboard.writeText(pre.innerText.trim())
        pre.dataset.copied = ''
        setTimeout(() => delete pre.dataset.copied, 1500)
      })
    </script>
  </body>
</html>

<style>
  .blog-container {
    max-width: 65ch;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    min-height: 100vh;
  }

  .blog-container.wide {
    max-width: 90rem;
  }

  .terminal-header {
    display: flex;
    align-items: baseline;
    gap: 0;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .prompt-arrow {
    color: var(--color-term-prompt);
    margin-right: 0.5rem;
  }

  .path-base {
    color: var(--color-term-dir);
    text-decoration: none;
    transition: color 0.15s;
  }

  .path-base:hover {
    color: var(--color-term-link);
  }

  .path-segment {
    color: var(--color-term-dir);
    text-decoration: none;
    transition: color 0.15s;
  }

  .path-segment:hover {
    color: var(--color-term-link);
  }

  .path-current {
    color: var(--color-term-fg-muted);
  }

  .git-info {
    color: var(--color-term-fg-muted);
    margin-left: 0.5rem;
  }

  .branch {
    color: var(--color-term-branch);
  }

  .back-link {
    display: inline-block;
    color: var(--color-term-fg-muted);
    text-decoration: none;
    font-size: 0.875rem;
    margin-bottom: 2.5rem;
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--color-term-link);
  }

  .blog-content {
    line-height: 1.7;
  }
</style>

<style is:global>
  .blog-content pre:not(.mermaid) {
    cursor: copy;
    position: relative;
  }
  .blog-content pre[data-copied]::after {
    content: 'copied';
    position: absolute;
    top: 0.4rem;
    right: 0.6rem;
    font-size: 0.75rem;
    opacity: 0.7;
  }
</style>
