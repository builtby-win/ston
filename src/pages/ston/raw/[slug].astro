---
import { getCollection, render } from 'astro:content'
import TableOfContents from '../../../components/TableOfContents.astro'
import BlogLayout from '../../../layouts/BlogLayout.astro'

export async function getStaticPaths() {
  const isDev = import.meta.env.DEV
  const notes = await getCollection('raw', ({ data }) => isDev || !data.draft)

  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }))
}

const { note } = Astro.props
const { Content, headings } = await render(note)

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  })
}
---

<BlogLayout
  title={note.data.title}
  description={note.data.description}
  pathSegments={[
    { name: 'raw', href: '/ston/raw/' },
    { name: note.id, href: null },
  ]}
  backHref="/ston/raw/"
>
  <article class="post-layout">
    <header class="post-header">
      <h1 class="post-title">{note.data.title}</h1>
      {note.data.description && (
        <p class="post-description">{note.data.description}</p>
      )}
      <time class="post-date" datetime={note.data.date.toISOString()}>
        {formatDate(note.data.date)}
      </time>
      {note.data.tags && note.data.tags.length > 0 && (
        <div class="post-tags">
          {note.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>
    <aside class="post-outline">
      <TableOfContents headings={headings} />
    </aside>
    <div class="prose">
      <Content />
    </div>
  </article>
</BlogLayout>

<style>
  .post-layout {
    max-width: 75ch;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 2.5rem;
  }

  .post-outline {
    margin-bottom: 2.5rem;
  }

  .prose {
    min-width: 0;
  }

  .post-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-term-fg);
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .post-description {
    color: var(--color-term-fg-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .post-date {
    color: var(--color-term-fg-muted);
    font-size: 0.875rem;
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .tag {
    color: var(--color-term-branch);
    font-size: 0.75rem;
  }

  .tag::before {
    content: '#';
    opacity: 0.7;
  }
</style>
